# .changelog-platform.yml.example
#
# Copy this file to .changelog-platform.yml (no ".example" suffix) to override
# the auto-detection logic in scripts/detect-platform.sh.
#
# IMPORTANT: .changelog-platform.yml is gitignored. Do not commit it — it contains
# installation-specific values (base URLs, project keys) that differ between users
# and environments.
#
# Required only for:
#   - Self-hosted GitHub Enterprise (GHE) or self-hosted GitLab instances whose
#     hostnames do not match *.github.com or *.gitlab.com
#   - Bitbucket Datacenter installations whose HTTP clone URL does not contain /scm/
#     (e.g., reverse-proxied installations where /scm/ is stripped)
#   - Any case where auto-detection produces "unknown" or an incorrect result
#
# All keys are optional — omit any key to accept the auto-detected value.
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED KEYS (if any override is needed at all)
# ─────────────────────────────────────────────────────────────────────────────

# platform: One of the four supported identifiers. Overrides the URL-based heuristic.
#           Valid values: github | gitlab | bitbucket-cloud | bitbucket-datacenter
#
# Example — self-hosted GitLab whose hostname does not contain "gitlab":
# platform: gitlab
#
# Example — Bitbucket Datacenter with a custom reverse proxy (no /scm/ in clone URL):
# platform: bitbucket-datacenter

# base_url: The scheme + host (no trailing slash) of the git hosting instance.
#           Required for self-hosted platforms; ignored for github.com / gitlab.com /
#           bitbucket.org where the host is parsed from the remote URL.
#
# Example — GitHub Enterprise:
# base_url: https://github.mycompany.com
#
# Example — Self-hosted GitLab:
# base_url: https://gitlab.mycompany.com
#
# Example — Bitbucket Datacenter:
# base_url: https://bitbucket.mycompany.com

# ─────────────────────────────────────────────────────────────────────────────
# BITBUCKET DATACENTER KEYS
# (only relevant when platform: bitbucket-datacenter)
# ─────────────────────────────────────────────────────────────────────────────

# project_key: The Bitbucket Datacenter project key — a short uppercase identifier
#              that maps to a project container. Found in the web UI under the project
#              name (e.g., PROJ, BACKEND, MYTEAM). This is NOT the same as the
#              repo slug.
#
#              For personal repositories, use the tilde-prefixed username:
#                project_key: ~johnsmith
#
#              Required for bitbucket-datacenter when the project key cannot be
#              parsed from the remote URL (e.g., SSH SCP-style clone URLs).
#
# project_key: PROJ

# repo_slug: The repository slug as it appears in the Bitbucket Datacenter URL.
#            Usually the same as the repo name in lowercase with hyphens.
#            Auto-detected from the remote URL in most cases; set this override
#            only if auto-detection produces the wrong value.
#
# repo_slug: my-repo

# ─────────────────────────────────────────────────────────────────────────────
# CHANGELOG GENERATION KEYS
# ─────────────────────────────────────────────────────────────────────────────

# tag_format: Template for constructing git tags from a component slug and version.
#             Supported placeholders:
#               {slug}    — the component slug (e.g., "changelog", "frankenstein")
#               {version} — the semver string without a leading "v" (e.g., "1.2.0")
#
#             Default value (shown below) produces dash-style tags, e.g.:
#               changelog-v1.2.0
#               frankenstein-v1.5.0
#
#             This format is URL-safe on all four supported platforms — no percent-
#             encoding needed in compare URLs or query parameters.
#
#             Avoid formats that introduce slashes or "@" characters:
#               AVOID: {slug}/{version}   → skills/changelog/v1.2.0 (slash in tag)
#               AVOID: {slug}@{version}   → changelog@1.2.0 (@ encoded as %40)
#
#             See .orchestrator/context/platform-inventory.md §6 for the full
#             pros/cons analysis of tag format choices.
# tag_format: "{slug}-v{version}"

# default_branch: The default branch name for Unreleased link generation.
# Used by Bitbucket Cloud (instead of HEAD) and Bitbucket Datacenter (in sourceBranch param).
# Default: main
# default_branch: main
