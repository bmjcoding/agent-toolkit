# Codex CLI project configuration template
# Version: Codex CLI v0.120.0
#
# Usage:
#   Copy this file to .codex/config.toml in a trusted project repo.
#   Global config lives at ~/.codex/config.toml.
#   Project config is only loaded from trusted repos (codex trust <dir>).

# ---------------------------------------------------------------------------
# Core settings
# ---------------------------------------------------------------------------

# Default model for all sessions (override per-agent in ~/.codex/agents/<n>.toml)
model = "gpt-5.4"

# Sandbox mode controls filesystem and network access.
# Values: "workspace-write" | "read-only" | "danger-full-access"
sandbox_mode = "workspace-write"

# Approval policy for tool calls.
# Values: "on-request" | "untrusted" | "never"
# "on-request"  — prompts for approval on tool calls that modify state (recommended)
# "untrusted"   — approves read-only; prompts for writes/deletes
# "never"       — approves all tool calls without prompting (use with caution)
approval_policy = "on-request"

# ---------------------------------------------------------------------------
# Skills configuration
#
# NOTE: skills.config[].path points to the SKILL.md file inside the skill
# directory, not the directory itself.
#
# Codex discovers skills from (in order):
#   1. paths listed in [[skills.config]] entries below
#   2. .agents/skills/ at the repo root
#   3. $HOME/.agents/skills/
#   4. /etc/codex/skills/
#   5. bundled skills
#
# ---------------------------------------------------------------------------

[[skills.config]]
path = "${AGENT_TOOLKIT_DIR}/skills/backend/SKILL.md"
enabled = true

[[skills.config]]
path = "${AGENT_TOOLKIT_DIR}/skills/changelog/SKILL.md"
enabled = true

