{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/branch-guard/branch-guard.sh",
            "statusMessage": "Checking branch guard..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/changelog-check/changelog-check.sh",
            "statusMessage": "Validating changelog entry..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/dispatch-validate/dispatch-validate.sh",
            "statusMessage": "Validating dispatch prompt..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/git-signing-preflight/git-signing-preflight.sh",
            "statusMessage": "Pre-flighting git signing keys..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/pre-push-secrets/pre-push-secrets.sh",
            "statusMessage": "Scanning for secrets before push..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/protect-config/protect-config.sh",
            "statusMessage": "Checking config protection..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/integrity-warn/integrity-warn.sh",
            "statusMessage": "Running integrity check..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/printf-lint/printf-lint.sh",
            "statusMessage": "Linting printf safety..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/inject-context/inject-context.sh",
            "statusMessage": "Injecting session context..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/extract-handoff/extract-handoff.sh",
            "statusMessage": "Extracting handoff JSON..."
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "${AGENT_TOOLKIT_DIR:-$HOME/.codex}/openai-codex/hooks/post-agent-audit/post-agent-audit.sh",
            "statusMessage": "Auditing agent scope..."
          }
        ]
      }
    ]
  }
}
