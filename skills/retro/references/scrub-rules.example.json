{
  "_comment": "scrub.py rule configuration file. Copy to scrub-rules.json (gitignored) and customize for your environment.",
  "_doc": "Each rule: {id, pattern, replacement, flags_dotall (optional bool)}. Rules apply in array order — place more-specific rules before catch-alls. See retro-schema.md 'Rule Ordering' for ordering constraints.",
  "rules": [
    {
      "id": "R-10",
      "pattern": "(\"project\"\\s*:\\s*\")(/Users/[^/]+[^\"]*)(\")",
      "replacement": "\\1<path>\\3",
      "_comment": "JSON project field with absolute path — must run before R-03 catch-all"
    },
    {
      "id": "R-11",
      "pattern": "(\"project\"\\s*:\\s*\")(alt-central[^\"]*)(\")",
      "replacement": "\\1<project>\\3",
      "_comment": "JSON project field with codename — must run before R-12 narrative rule"
    },
    {
      "id": "R-01",
      "pattern": "/Users/[^/]+/Developer/git/",
      "replacement": "/Users/<user>/Developer/git/",
      "_comment": "Developer git path — must run before R-03 catch-all"
    },
    {
      "id": "R-02",
      "pattern": "/Users/[^/]+/\\.claude/",
      "replacement": "~/.claude/",
      "_comment": "User .claude path — must run before R-03 catch-all"
    },
    {
      "id": "R-03",
      "pattern": "/Users/[^/]+/",
      "replacement": "/Users/<user>/",
      "_comment": "Catch-all /Users/<username>/ path — runs after R-01, R-02, R-10"
    },
    {
      "id": "R-04",
      "pattern": "-Users-[^-]+-Developer-git-",
      "replacement": "-Users-<user>-Developer-git-"
    },
    {
      "id": "R-05",
      "pattern": "-Users-[^-]+--claude",
      "replacement": "-Users-<user>--claude"
    },
    {
      "id": "R-06",
      "pattern": "[^/]+/alt-central",
      "replacement": "<user>/<project>",
      "_comment": "Org/repo compound form — must run before R-12 narrative alt-central rule"
    },
    {
      "id": "R-07",
      "pattern": "[^/]+/ftfb-automation",
      "replacement": "REDACT"
    },
    {
      "id": "R-12",
      "pattern": "alt-central",
      "replacement": "<project>",
      "_comment": "Narrative codename — runs after R-06 and R-11"
    },
    {
      "id": "R-13",
      "pattern": "ftfb-automation",
      "replacement": "<project>"
    },
    {
      "id": "R-14",
      "pattern": "ftb-automation",
      "replacement": "<project>"
    }
  ],
  "skipped": [
    {
      "id": "R-08",
      "pattern": "bmjcoding/claude-toolkit",
      "_comment": "bmjcoding org preserved — user decision"
    },
    {
      "id": "R-09",
      "pattern": "bmjcoding/agent-toolkit",
      "_comment": "bmjcoding org preserved — user decision"
    },
    {
      "id": "R-15",
      "pattern": "git@github.com:bmjcoding/",
      "_comment": "bmjcoding org preserved — user decision"
    },
    { "id": "R-16", "_comment": "commit SHAs — preserved — user decision" }
  ]
}
