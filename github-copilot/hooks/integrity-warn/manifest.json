  "version": "3.0.0",
  "ref": "main",
  "download_url": "https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/github-copilot/hooks/integrity-warn.json",
  "install_path": ".github/hooks/",
  "install_command": "mkdir -p .github/hooks && curl -fsSL https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/github-copilot/hooks/integrity-warn.json -o .github/hooks/integrity-warn.json && curl -fsSL https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/github-copilot/hooks/integrity-warn.sh -o .github/hooks/integrity-warn.sh",
  "files": ["integrity-warn.json", "integrity-warn.sh"],
  "status": "available",
  "tooltip_text": "",
  "docs_url": "https://code.visualstudio.com/docs/copilot/customization/overview",
