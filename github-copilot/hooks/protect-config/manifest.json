{
  "id": "protect-config",
  "name": "Protect Config",
  "type": "hook",
  "tool": "github-copilot",
  "version": "3.0.0",
  "ref": "main",
  "download_url": "https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/github-copilot/hooks/protect-config.json",
  "install_path": ".github/hooks/",
  "install_command": "mkdir -p .github/hooks && curl -fsSL https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/github-copilot/hooks/protect-config.json -o .github/hooks/protect-config.json && curl -fsSL https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/github-copilot/hooks/protect-config.sh -o .github/hooks/protect-config.sh",
  "files": ["protect-config.json", "protect-config.sh"],
  "status": "available",
  "tooltip_text": "",
  "docs_url": "https://code.visualstudio.com/docs/copilot/customization/overview",
  "experimental": false,
  "notes": "PreToolUse hook — blocks unauthorized writes to protected configuration files (CLAUDE.md, settings.json, etc.)."
}
