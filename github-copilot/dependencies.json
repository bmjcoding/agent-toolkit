    {"from": "agents/frontend-engineer", "to": "skills/design-authority", "note": "references design-authority skill"},
    {"from": "agents/release-gate", "to": "skills/prod-readiness", "note": "references prod-readiness skill"},
    {"from": "agents/security-engineer", "to": "skills/owasp-reference", "note": "references owasp-reference skill"},
    {"from": "agents/site-reliability-engineer", "to": "skills/observability-patterns", "note": "references observability-patterns skill"},
