{
  "id": "integrity-warn",
  "name": "Integrity Warn",
  "type": "hook",
  "tool": "claude-code",
  "version": "3.0.0",
  "ref": "main",
  "download_url": "https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/claude-code/hooks/integrity-warn/integrity-warn.sh",
  "install_path": "~/.claude/hooks/",
  "install_command": "curl -fsSL https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/claude-code/hooks/integrity-warn/integrity-warn.sh -o ~/.claude/hooks/integrity-warn.sh && chmod +x ~/.claude/hooks/integrity-warn.sh",
  "files": ["integrity-warn.sh", "CHANGELOG.md"],
