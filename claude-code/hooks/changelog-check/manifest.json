{
  "id": "changelog-check",
  "name": "Changelog Check",
  "type": "hook",
  "tool": "claude-code",
  "version": "3.0.0",
  "ref": "main",
  "download_url": "https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/claude-code/hooks/changelog-check/changelog-check.sh",
  "install_path": "~/.claude/hooks/",
  "install_command": "curl -fsSL https://raw.githubusercontent.com/bmjcoding/agent-toolkit/main/claude-code/hooks/changelog-check/changelog-check.sh -o ~/.claude/hooks/changelog-check.sh && chmod +x ~/.claude/hooks/changelog-check.sh",
  "files": ["changelog-check.sh", "CHANGELOG.md"],
  "status": "available",
  "tooltip_text": "PreToolUse hook that blocks git push if CHANGELOG.md was not modified in any commit being pushed. Enforces the changelog-first workflow.",
  "docs_url": "https://docs.anthropic.com/en/docs/claude-code/hooks",
  "experimental": false,
  "notes": "Register in ~/.claude/settings.json hook events after install."
}
