{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/bmjcoding/agent-toolkit/tools/retros/schemas/retro-v5.0.json",
  "title": "Retro v5.0",
  "description": "Canonical JSON Schema for Claude Code session retrospectives. Normalizes Gen1-Gen4 formats.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "subject",
    "session_id",
    "date",
    "run_type",
    "depth",
    "findings",
    "findings_total",
    "recommendations",
    "quality_iterations",
    "agents_spawned",
    "files_changed",
    "user_interventions",
    "root_causes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "5.0",
      "description": "Schema version \u2014 always '5.0' for this schema."
    },
    "subject": {
      "type": "string",
      "description": "Human-readable description of what this session worked on."
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}$",
      "description": "Session identifier in compact ISO-8601 format: YYYYMMDDTHHmmss."
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Calendar date of the session in ISO-8601 format (YYYY-MM-DD)."
    },
    "run_type": {
      "type": "string",
      "enum": [
        "single-agent",
        "subagent",
        "orchestration",
        "meta",
        "custom-pipeline"
      ],
      "description": "Execution model used for the session."
    },
    "depth": {
      "type": "string",
      "enum": [
        "lightweight",
        "standard",
        "full"
      ],
      "description": "Depth of the retrospective analysis."
    },
    "findings": {
      "type": "object",
      "description": "Finding counts grouped by severity.",
      "properties": {
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "findings_total": {
      "type": "integer",
      "minimum": 0,
      "description": "Sum of all findings across all severities."
    },
    "recommendations": {
      "type": "object",
      "description": "Recommendation counts grouped by priority and type.",
      "properties": {
        "total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p0": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p1": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "p2": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "fix": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pattern": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "quality_iterations": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of quality-improvement iterations performed."
    },
    "agents_spawned": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of agent dispatches including stubs."
    },
    "files_changed": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of files written or modified during the session."
    },
    "user_interventions": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of times the user had to intervene to unblock the session."
    },
    "root_causes": {
      "type": "object",
      "description": "Count of root cause categories observed across findings.",
      "properties": {
        "prompt_gap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "spec_gap": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "context_overflow": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tool_failure": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "external": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "verdict": {
      "description": "Ship-gate verdict for this session.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "CLEAR_TO_SHIP",
            "SHIP_WITH_CAUTION",
            "BLOCKED",
            "SHIPPED_CLEAN"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "total_tokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Total tokens consumed across all agents in this session."
    },
    "total_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Total metered cost in USD. Excludes dispatcher tokens (known gap: understates by ~5-15%)."
    },
    "agents_metered": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Count of agents with non-null token entries in agents.log."
    },
    "wall_clock_min": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Wall-clock duration of the session in minutes. Derivable from agents.log timestamp span."
    },
    "plan_revisions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Number of plan revisions during the session."
    },
    "model_downgrades_recommended": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "Number of model-downgrade recommendations made during the session."
    },
    "metrics": {
      "type": "object",
      "description": "Extended per-pipeline metrics block.",
      "properties": {
        "total_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "total_cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "agents_spawned": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "agents_metered": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "wall_clock_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "quality_iterations": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "findings_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "findings_critical": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "findings_high": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "findings_medium": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "findings_low": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "plan_revisions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "user_interventions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "model_downgrades_recommended": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "verdict": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "CLEAR_TO_SHIP",
                "SHIP_WITH_CAUTION",
                "BLOCKED",
                "SHIPPED_CLEAN"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "root_cause_counts": {
          "type": "object",
          "properties": {
            "prompt_gap": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "spec_gap": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "context_overflow": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "tool_failure": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "external": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "frankenstein": {
      "type": "object",
      "description": "Frankenstein orchestrator health sub-block (orchestration retros only).",
      "properties": {
        "line_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "net_line_delta": {
          "type": [
            "integer",
            "null"
          ]
        },
        "net_growth_flag": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dispatch_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "dispatcher_tokens_estimated": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Always null \u2014 not yet captured by hooks (known gap)."
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": "array",
      "description": "Per-agent performance records.",
      "items": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "tokens_in": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "tokens_out": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "tool_uses": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "finding_list": {
      "type": "array",
      "description": "Detailed list of individual findings.",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "finding": {
            "type": "string"
          },
          "finding_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolved": {
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "severity",
          "finding"
        ],
        "additionalProperties": true
      }
    }
  }
}
